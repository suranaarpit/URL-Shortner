<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="shortcut icon"
      href="https://docrdsfx76ssb.cloudfront.net/static/1654619563/pages/wp-content/uploads/2019/02/favicon.ico"
      type="image/x-icon"
    />
    <script src="https://cdn.tailwindcss.com"></script>

    <title>
      URL Shortener - Short URLs & Custom Free Link Shortener | Bitly
    </title>
  </head>
  <body>
    <!-- NAV BAR -->
    <section style="width: 1140px; margin: auto">
      <header class="text-gray-600 body-font">
        <div
          class="container mx-auto flex flex-wrap p-5 flex-col md:flex-row items-center"
        >
          <img
            style="max-width: 100px"
            src="https://docrdsfx76ssb.cloudfront.net/static/1654619563/pages/wp-content/uploads/2021/08/bitly_logo.svg"
            alt="logo"
          />
          <nav
            class="md:mr-auto md:ml-4 md:py-1 md:pl-4 flex flex-wrap items-center text-base justify-center"
          >
            <a href="#" class="mr-5 hover:text-[blue]">Why Bitly?</a>
            <a href="#" class="mr-5 hover:text-[blue]">Solutions</a>
            <a href="#" class="mr-5 hover:text-[blue]">Features</a>
            <a href="#" class="mr-5 hover:text-[blue]">Pricing</a>
          </nav>
          <a href="#" class="mr-5 hover:text-[blue]">Log in</a>
          <a href="#" class="mr-5 text-[blue]">Sign up Free</a>
          <button
            class="inline-flex text-[white] items-center bg-[blue] border-0 py-2 px-3 focus:outline-none rounded text-base mt-4 md:mt-0"
          >
            Get a Quote
            <svg
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              class="w-4 h-4 ml-1"
              viewBox="0 0 24 24"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </header>
    </section>
    <!-- BANNER -->
    <section style="width: 1140px; margin: auto">
      <!-- This example requires Tailwind CSS v2.0+ -->
      <div class="relative bg-white overflow-hidden">
        <div class="pt-16 pb-80 sm:pt-24 sm:pb-40 lg:pt-40 lg:pb-48">
          <div
            class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 sm:static"
          >
            <div class="sm:max-w-lg">
              <h1
                class="text-4xl font font-extrabold tracking-tight text-gray-900 sm:text-6xl"
              >
                Short links, big results
              </h1>
              <p class="mt-4 text-xl text-gray-500">
                A URL shortener built with powerful tools to help you grow and
                protect your brand.
              </p>
            </div>
            <div>
              <div class="mt-10">
                <!-- Decorative image grid -->
                <div
                  aria-hidden="true"
                  class="pointer-events-none lg:absolute lg:inset-y-0 lg:max-w-7xl lg:mx-auto lg:w-full"
                >
                  <img
                    src="https://docrdsfx76ssb.cloudfront.net/static/1654619563/pages/wp-content/uploads/2022/04/H_Generic-LP-2.svg"
                    alt="banner"
                  />
                  <div
                    class="absolute transform sm:left-1/2 sm:top-0 sm:translate-x-8 lg:left-1/2 lg:top-1/2 lg:-translate-y-1/2 lg:translate-x-8"
                  >
                    <div class="flex items-center space-x-6 lg:space-x-8">
                      <div
                        class="flex-shrink-0 grid grid-cols-1 gap-y-6 lg:gap-y-8"
                      ></div>
                    </div>
                  </div>
                </div>

                <a
                  href="#"
                  class="inline-block text-center bg-[blue] border border-transparent rounded-md py-3 px-8 font-medium text-white hover:bg-indigo-600"
                  >Get Started for Free</a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- MAIN URL SHORTNER SECTION -->
    <section class="border border-white h-[300px] bg-[#0b1736]">
      <div class="h-[60px] mt-14 w-[1024px] m-auto">
        <% if (locals.error) { %>
        <p class="errors text-white"><%= error %></p>
        <% } %>
        <form action="/" method="post" class="flex h-[60px] justify-between">
          <!-- INPUT BOX -->
          <div class="w-[740px] h-full rounded-[10px]">
            <input
              class="w-full h-full rounded-[10px] p-5 text-xl outline-none"
              type="url"
              name="url"
              id="url"
              placeholder="Shorten your link"
            />
          </div>
          <!-- BUTTON -->
          <div class="w-[250px] h-full rounded-[10px]">
            <input
              class="cursor-pointer w-full h-full rounded-[10px] text-xl outline-none bg-[#1b3987] text-white"
              type="submit"
              value="Shorten"
            />
          </div>
        </form>
      </div>

      <!-- Shorted Links Div -->
      <div
        class="short-url border border-white w-[955px] h-[100px] m-auto mt-9"
      >
        <% if (locals.short_url) { %>
        <a href="<%= short_url %>"><%= short_url %> </a>
        <% } %>
      </div>
    </section>
  </body>
</html>




